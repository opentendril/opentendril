# === OpenTendril .envrc Example ===
# Source this file from your shell to load .env variables.
#
# Usage:
#   echo 'source .envrc' >> ~/.bashrc
#   source ~/.bashrc
#
# The .envrc file is sourced by the Stem to load environment variables
# from .env. It supports GitHub token injection via `gh auth token`.
#
# Example:
#   echo 'source .envrc' >> ~/.bashrc
#   source ~/.bashrc
#   echo 'source .envrc' >> ~/.zshrc
#   source ~/.zshrc
#
# The .envrc file is sourced by the Stem to load environment variables
# from .env. It supports GitHub token injection via `gh auth token`.
#
# Example:
#   echo 'source .envrc' >> ~/.bashrc
#   source ~/.bashrc
#   echo 'source .envrc' >> ~/.zshrc
#   source ~/.zshrc

# GitHub PAT for terrarium git clones/pushes (fine-grained, repo-scoped).
# Tip: use .envrc (see .envrc.example) to source it from `gh auth token`.
GITHUB_TOKEN=

# Source .envrc from .envrc.example
# echo 'source .envrc' >> ~/.bashrc
# source ~/.bashrc
# echo 'source .envrc' >> ~/.zshrc
# source ~/.zshrc
