# Command Center front: static SPA + single-origin reverse proxy to the
# Stem. Upstreams are written at container start by 15-stem-transport.sh
# (Unix socket by default; TCP only when STEM_TRANSPORT=tcp).
#
# Security posture:
#   - Single origin: the browser only ever talks to this container, so the
#     Stem needs no CORS headers (adding them was explicitly rejected).
#   - Auth passthrough: the operator's `Authorization: Bearer` key is
#     forwarded untouched; the Stem's withAPIKeyAuth remains the sole
#     authority. This proxy adds no credentials and bypasses nothing.
#   - Nothing else on the host is reachable: only /health, /v1*, and /ws
#     are proxied; every other path serves the static bundle.

# WebSocket upgrade negotiation.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

include /tmp/stem-upstreams.conf;

server {
    listen 8080;
    server_name _;

    root  /usr/share/nginx/html;
    index index.html;

    # Hardening headers (apply to the SPA and proxied API responses alike).
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;
    # style-src keeps 'unsafe-inline' only as a fallback for browsers that
    # don't understand the CSP3 style-src-elem/style-src-attr split below.
    # Where the split is understood:
    #   - style-src-attr allows the React inline style="" attributes the UI
    #     actually uses (e.g. ui/src/components/CommandCenter.tsx).
    #   - style-src-elem locks <style> tags / stylesheets to 'self', so an
    #     XSS payload can no longer inject an arbitrary <style> element for
    #     CSS-based exfiltration or UI redress. script-src already blocks
    #     inline/eval script execution; this closes the analogous style gap.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; style-src-elem 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

    # ---- Static SPA shell ---------------------------------------------------
    location / {
        try_files $uri /index.html;
    }

    # ---- Reverse proxy: the Stem's documented API surface -------------------
    location = /health {
        proxy_pass http://stem_api;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # /v1 and everything under it: sessions, history/events/sprout-runs,
    # chat completions, config, MCP. Upgrade headers included so any future
    # WebSocket endpoint under /v1 (e.g. mesh grafting) also negotiates.
    location /v1 {
        proxy_pass http://stem_api;
        proxy_http_version 1.1;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ---- Live EventBus feed (WebSocket) --------------------------------------
    # The Stem mux already serves /ws, so the local Unix socket is enough.
    # Explicit TCP mode may still prefer the dedicated gateway listener.
    location = /ws {
        proxy_pass http://stem_ws;
        proxy_http_version 1.1;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # An idle operator dashboard must not be disconnected mid-shift.
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }
}
